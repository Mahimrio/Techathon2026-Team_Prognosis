{
  "name": "officevolt",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "bot"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend,bot -c blue,green,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\" \"npm run dev -w bot\"",
    "start": "npm start -w backend",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
